// manifest.json
{
  "manifest_version": 3,
  "name": "Instagram Cookie Export",
  "version": "1.0",
  "description": "Export Instagram session cookies",
  "permissions": ["cookies", "activeTab", "scripting"],
  "host_permissions": ["*://instagram.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}